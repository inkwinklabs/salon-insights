<?xml version="1.0" encoding="utf-8"?>
<!-- Android blocks plain "http://" by default. We allow it for ONE address only:
     127.0.0.1, which means "this phone itself" (the Python server inside the app).
     Everything that leaves the phone (the AI request) still must use https. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
